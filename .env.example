# ReturnGuard Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Server Host & Port
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# AI Safety Guardrails
MAX_AUTONOMOUS_REFUND_LIMIT=500.00
FRAUD_ESCALATION_THRESHOLD=60

# Optional External LLM Integration (Fallback to Deterministic ReAct Engine if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Stripe Integration (Mock mode active by default)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
